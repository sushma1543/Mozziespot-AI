FROM python:3.11-slim

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt requirements-research.txt ./
RUN pip install --no-cache-dir -r requirements-research.txt
COPY . .
CMD ["python", "train_water_models.py", "--data-root", "/datasets/sen1floods11", "--models", "unet", "deeplabv3plus", "segformer", "--epochs", "20"]
